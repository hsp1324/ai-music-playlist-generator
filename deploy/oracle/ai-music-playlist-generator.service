[Unit]
Description=AI Music Playlist Generator
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-music-playlist-generator
EnvironmentFile=/etc/ai-music-playlist-generator.env
ExecStart=/opt/ai-music-playlist-generator/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log --limit-concurrency 64 --backlog 512
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
